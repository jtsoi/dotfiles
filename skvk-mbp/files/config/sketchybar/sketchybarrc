#!/usr/bin/env bash
# Managed by skvk-mbp/mise.toml ([dotfiles]).
# Reference: https://felixkratz.github.io/SketchyBar/
set -euo pipefail

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
# shellcheck source=SCRIPTDIR/colors.sh
source "$CONFIG_DIR/colors.sh"

# Source Code Pro, the typeface the old i3 config used, in its Nerd Font
# patching so glyphs and text come from one family rather than needing a
# fallback face the way i3 needed FontAwesome alongside it.
FONT="SauceCodePro Nerd Font"

# sketchybar-app-font is ligature-based rather than codepoint-based: the label
# text is the literal string ":slack:" and the font's GSUB table substitutes it
# for a single icon glyph. That is why these are app names and not escapes.
APP_FONT="sketchybar-app-font"

# height is authoritative for outer.bottom in aerospace.toml, which must be this
# plus 4 to match the inner gaps. Nothing syncs the two: change both together.
sketchybar --bar \
    position=bottom \
    height=32 \
    margin=0 \
    y_offset=0 \
    padding_left=10 \
    padding_right=10 \
    color="$BAR_BG"

sketchybar --default \
    label.font="$FONT:Medium:14" \
    icon.font="$FONT:Medium:16" \
    label.color="$FG" \
    icon.color="$FG" \
    padding_left=5 \
    padding_right=5

# A drawn rule, not a typeset one. This font's | glyph carries no ink -- a red
# X in the same item renders while a | renders nothing, and the measurement
# gives it away: in a monospaced face X advances 13pt and | only 5pt. U+2502
# fails the same way. So the separator is a 2px filled background, which owes
# nothing to the typeface.
#
# x_offset is doing real work: an item whose label and icon are both off gets a
# smaller layout advance than its padding implies, so the next item starts left
# of where the rule is drawn and the rule lands on top of its first character.
# Shifting the rule back by 8 puts it in the gap. padding_right does not help --
# it is ignored for an item with no content to pad.
separator() {
    # The shift flips with the stacking direction: the left group lays out
    # left-to-right so the rule has to move left out of the next item, and the
    # right group lays out right-to-left so it has to move right.
    # -8 and 11 are measured, not guessed: on each side the rule is flush
    # against one neighbour at one end of a 6px window and flush against the
    # other at the far end, so these are the midpoints.
    local off=-8
    [ "$2" = "right" ] && off=11
    sketchybar --add item "$1" "$2" \
               --set "$1" label.drawing=off \
                     icon.drawing=off \
                     width=2 \
                     background.drawing=on \
                     background.color="$SEP" \
                     background.height=18 \
                     background.corner_radius=1 \
                     background.x_offset="$off" \
                     padding_left=10 \
                     padding_right=10
}

# The left group renders in insertion order.
sketchybar --add item clock left \
           --set clock script="$PLUGIN_DIR/datetime.sh local" update_freq=30 \
                       label.color="$FG"
separator sep.l1 left
sketchybar --add item utc left \
           --set utc script="$PLUGIN_DIR/datetime.sh utc" update_freq=30 \
                     label.color="$DIM"
separator sep.l2 left
sketchybar --add item isoweek left \
           --set isoweek script="$PLUGIN_DIR/datetime.sh isoweek" update_freq=3600 \
                         label.color="$DIM"
separator sep.l3 left

# update_freq=0 at startup because the script raises it to 1 itself when a
# block is running -- including after a restart, since the state file
# survives.
# The mouse.clicked subscription is the ONLY click path. A click_script would
# also fire the plugin, but with no $SENDER set -- so it took the render-only
# branch and raced the subscribed invocation that writes the state, which is how
# a click could render the state it had before the toggle.
#
# icon.padding_right separates the glyph from the countdown; they touched.
sketchybar --add item pomodoro left \
           --set pomodoro script="$PLUGIN_DIR/pomodoro.sh" \
                          update_freq=0 \
                          icon.padding_right=6 \
           --subscribe pomodoro mouse.clicked

# Must exist before anything subscribes or AeroSpace's on-focus-changed
# triggers it: sketchybar only delivers a trigger for an event --add'ed first.
sketchybar --add event aerospace_focus

# Every workspace draws its button all the time, so the row reads as twelve
# fixed targets rather than one label that happens to be lit.
#
# The label padding is what makes a single-character chip about as wide as it is
# tall. Do not reach for label.width to even out the 1px width variation this
# font's glyph advance causes: it replaces the padding rather than adding to it,
# and collapses every chip to the label's own width.
#
# y_offset corrects this font's vertical metrics, which centre the glyph about
# two points above the chip's middle. Negative moves the label down.
# The three named workspaces are named after the app pinned to them by the
# on-window-detected rules in aerospace.toml, so they show that app's icon
# instead of its initial. The digits stay digits.
for ws in 1 2 3 4 5 6 7 8 9 M L S; do
    case "$ws" in
        M) label=":sublime_merge:" ; font="$APP_FONT:Regular:12" ; pad=7  ;;
        L) label=":linear:"        ; font="$APP_FONT:Regular:12" ; pad=7  ;;
        S) label=":slack:"         ; font="$APP_FONT:Regular:12" ; pad=7  ;;
        *) label="$ws"             ; font="$FONT:Medium:14"      ; pad=10 ;;
    esac
    sketchybar --add item "space.$ws" center \
               --set "space.$ws" \
                     label="$label" \
                     label.font="$font" \
                     label.color="$DIM" \
                     label.padding_left="$pad" \
                     label.padding_right="$pad" \
                     label.y_offset=-2 \
                     background.color="$CHIP_EMPTY" \
                     background.border_color="$CHIP_BORDER" \
                     background.border_width=1 \
                     background.corner_radius=6 \
                     background.height=26 \
                     background.drawing=on \
                     padding_left=2 \
                     padding_right=2 \
                     click_script="aerospace workspace $ws" \
               --subscribe "space.$ws" aerospace_focus
done

sketchybar --set space.1 script="$PLUGIN_DIR/workspaces.sh"

# The right group renders RIGHT-TO-LEFT in insertion order, so battery is added
# first to land in the corner and cpu last to sit leftmost. Every item here is
# fixed-width, which is what keeps the row from shifting under itself.
sketchybar --add item battery right \
           --set battery script="$PLUGIN_DIR/battery.sh" update_freq=60 \
           --subscribe battery power_source_change
separator sep.r2 right
sketchybar --add item network right \
           --set network script="$PLUGIN_DIR/network.sh" update_freq=10
separator sep.r1 right
sketchybar --add item cpu right \
           --set cpu script="$PLUGIN_DIR/cpu.sh" update_freq=5

sketchybar --update
