#!/usr/bin/env bash
# Managed by skvk-mbp/mise.toml ([dotfiles]).
# Reference: https://felixkratz.github.io/SketchyBar/
set -euo pipefail

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
# shellcheck source=SCRIPTDIR/colors.sh
source "$CONFIG_DIR/colors.sh"

# Nerd Font patched, so glyphs and text come from one family rather than needing
# a fallback face declared alongside them the way the old i3 bar needed
# FontAwesome next to Source Code Pro.
FONT="JetBrainsMono Nerd Font"

# sketchybar-app-font is ligature-based rather than codepoint-based: the label
# text is the literal string ":slack:" and the font's GSUB table substitutes it
# for a single icon glyph. That is why these are app names and not escapes.
APP_FONT="sketchybar-app-font"

# The bar is a rounded panel hugging the bottom edge: margin insets it 2px each
# side, y_offset 0 keeps it flush to the screen bottom, and the 3px of air above
# its top edge comes from outer.bottom in aerospace.toml being height + 3.
# Nothing syncs those two numbers: change both together.
#
# topmost is on to keep the background flat. Underneath the windows, the bar
# catches the drop shadow of whatever sits above it: measured across empty bar
# space, the ground ran from 55% of its configured colour at the top edge to 97%
# at the bottom, which reads as a gradient nobody configured. Drawn on top, it
# measures flat at every height. AeroSpace already reserves the bar's space, so
# nothing is hidden by raising it.
sketchybar --bar \
    position=bottom \
    height=32 \
    margin=2 \
    y_offset=0 \
    topmost=on \
    corner_radius=14 \
    padding_left=10 \
    padding_right=10 \
    color="$BAR_BG"

sketchybar --default \
    label.font="$FONT:Medium:14" \
    icon.font="$FONT:Medium:16" \
    label.color="$FG" \
    icon.color="$FG" \
    padding_left=5 \
    padding_right=5

# A separator is a slim outlined rectangle: a 1px border around an item with no
# label and no icon, so only the outline draws.
#
# x_offset is doing real work. An item whose label and icon are both off gets a
# smaller layout advance than its padding implies, so without it the next item
# starts inside the drawn rectangle and the outline lands on its first
# character. -1 measures 5px clear on the left and 4px on the right, which is
# as centred as the gap allows. The shift flips with the stacking direction,
# hence the side test, and the right-hand value is untested while that group is
# empty.
separator() {
    local off=-1
    [ "$2" = "right" ] && off=8
    sketchybar --add item "$1" "$2" \
               --set "$1" label.drawing=off \
                     icon.drawing=off \
                     width=2 \
                     background.drawing=on \
                     background.color="$CHIP_EMPTY" \
                     background.border_color="$CHIP_BORDER" \
                     background.border_width=1 \
                     background.corner_radius=0 \
                     background.height=18 \
                     background.x_offset="$off" \
                     padding_left=3 \
                     padding_right=1
}

# The left group renders in insertion order. The clock is the one you read, so
# it carries the primary label colour and the other two are secondary.
sketchybar --add item clock left \
           --set clock script="$PLUGIN_DIR/datetime.sh local" update_freq=30 \
                       label.color="$FG" \
                       label.y_offset=1
separator sep.l1 left
sketchybar --add item utc left \
           --set utc script="$PLUGIN_DIR/datetime.sh utc" update_freq=30 \
                     label.color="$DIM" \
                     label.y_offset=1
separator sep.l2 left
sketchybar --add item isoweek left \
           --set isoweek script="$PLUGIN_DIR/datetime.sh isoweek" update_freq=3600 \
                         label.color="$DIM" \
                         label.y_offset=1

# Must exist before anything subscribes or AeroSpace's on-focus-changed
# triggers it: sketchybar only delivers a trigger for an event --add'ed first.
sketchybar --add event aerospace_focus

# Every workspace draws its button all the time, so the row reads as twelve
# fixed targets rather than one label that happens to be lit.
#
# The label padding is what makes a single-character chip about as wide as it is
# tall. Do not reach for label.width to even out the 1px width variation this
# font's glyph advance causes: it replaces the padding rather than adding to it,
# and collapses every chip to the label's own width.
#
# Every offset here was tuned against the rendered bar rather than derived:
# positive y_offset moves the label up, and asymmetric label padding shifts it
# sideways without changing the chip's width, a label having no x_offset of its
# own. The digits sit a point up and a point left of centre; the icons sit
# centred and a point lower, because the app font's vertical metrics are not the
# text font's.
# The three named workspaces are named after the app pinned to them by the
# on-window-detected rules in aerospace.toml, so they show that app's icon
# instead of its initial. The digits stay digits.
for ws in 1 2 3 4 5 6 7 8 9 M L S; do
    case "$ws" in
        M) label=":sublime_merge:" ; font="$APP_FONT:Regular:12" ; padl=6 ; padr=6  ; yoff=0 ;;
        L) label=":linear:"        ; font="$APP_FONT:Regular:12" ; padl=6 ; padr=6  ; yoff=0 ;;
        S) label=":slack:"         ; font="$APP_FONT:Regular:12" ; padl=6 ; padr=6  ; yoff=0 ;;
        *) label="$ws"             ; font="$FONT:Medium:14"      ; padl=9 ; padr=11 ; yoff=1 ;;
    esac
    sketchybar --add item "space.$ws" center \
               --set "space.$ws" \
                     label="$label" \
                     label.font="$font" \
                     label.color="$DIM" \
                     label.padding_left="$padl" \
                     label.padding_right="$padr" \
                     label.y_offset="$yoff" \
                     background.color="$CHIP_EMPTY" \
                     background.border_color="$CHIP_BORDER" \
                     background.border_width=1 \
                     background.corner_radius=6 \
                     background.height=26 \
                     background.drawing=on \
                     padding_left=2 \
                     padding_right=2 \
                     click_script="aerospace workspace $ws" \
               --subscribe "space.$ws" aerospace_focus
done

# space.1 carries the repaint for all twelve, and update_freq is what catches a
# Slack badge changing without any focus change -- the event alone would only
# notice unread that happened to coincide with switching workspace.
sketchybar --set space.1 script="$PLUGIN_DIR/workspaces.sh" update_freq=10

# The right group is empty for now. plugins/cpu.sh, network.sh and battery.sh
# are all still here and still covered by the harness -- see git history for the
# block that added their items, which also recorded that the right group lays
# out right-to-left, so the first item added lands in the corner.

sketchybar --update
